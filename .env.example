# =============================================================================
# Xtyle — variables de entorno
# Copia este archivo a .env.local y completa los valores:
#   copy .env.example .env.local
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Xtyle

# --- MongoDB (local / Compass) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=xtyle

# --- Clerk (https://dashboard.clerk.com → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# SuperAdmin de plataforma (email canónico, NO vive en Mongo)
SUPER_ADMIN_EMAIL=tu-email@dominio.com

# Desarrollo — omite Clerk OTP; login con email autorizado (cookie sx_dev_session)
# Nunca dejar en true en producción
XTYLE_DEV_BYPASS=true
DEV_SESSION_SECRET=cambia-este-secreto-local

# --- Cloudinary (upload solo vía API Next.js) ---
# Cloud name: el slug de Settings → API Keys (ej. dxxxx), NO el nombre del producto.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz en la mediateca (se crean subcarpetas por ficha)
CLOUDINARY_FOLDER=Xtyle
